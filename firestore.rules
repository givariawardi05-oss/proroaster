/**
 * @fileOverview Firestore Security Rules for a multi-tenant coffee roasting management application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. All data is stored within a
 * top-level `users` collection, and a user can only access documents within their
 * own user-specific path (`/users/{userId}`). This ensures data privacy and security
 * between different users of the application.
 *
 * Data Structure:
 * - /users/{userId}: Root document for a specific user's data.
 *   - /users/{userId}/{collection}/{documentId}: All other application data is nested here.
 * - /settings/{settingId}: Global application settings, readable by any authenticated user.
 *
 * Key Security Decisions:
 * - A user MUST be signed in to perform any operation.
 * - A user can ONLY read, write, update, or delete data that exists under their own UID path.
 *   This is enforced by the `isOwner()` function.
 * - The `settings` collection is read-only for all authenticated users.
 * - Schema validation is omitted for rapid prototyping.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description A user can manage their own profile document.
     * @path /users/{userId}
     * @allow (read, write): The user must be the owner of the document.
     */
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description User-specific collections. Access is granted only if the user is the owner.
     * This single rule block covers all nested collections for a user.
     * @path /users/{userId}/{anyCollection}/{anyDocument=**}
     * @allow (read, write): The user must be the owner of the parent user document.
     */
    match /users/{userId}/{anyCollection}/{anyDocument=**} {
       allow read, write: if isOwner(userId);
    }

    /**
     * @description Manages application-wide settings.
     * @path /settings/{settingId}
     * @allow (read): Any authenticated user can read settings.
     * @deny (write): No one can write to settings through the client.
     */
    match /settings/{settingId} {
      allow get, list: if isSignedIn();
      allow write: if false;
    }

    /**
     * @description Checks if the requesting user is the owner of the document.
     * @param {string} userId - The UID of the user to check against.
     * @returns {boolean} True if the requester's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /**
     * @description Checks if there is any authenticated user.
     * @returns {boolean} True if a user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}
